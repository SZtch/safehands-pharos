# ╔══════════════════════════════════════════════════════════════════════╗
# ║  SafeHands-Pharos — Environment Configuration                       ║
# ║  Pharos Atlantic Testnet ONLY — mainnet is blocked by design        ║
# ║                                                                     ║
# ║  ⚠  NEVER paste private keys into hosted backends                  ║
# ║  ⚠  NEVER commit this .env file — it is gitignored                 ║
# ║  ⚠  Testnet only — do not use mainnet keys here                    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Safe Public Defaults ─────────────────────────────────────────────────
# These values are safe for all users. Preflight/read-only mode works
# without any .env file at all.

PHAROS_ENVIRONMENT=atlantic-testnet
PHAROS_CHAIN_ID=688689
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com
RISK_REGISTRY_V2_ADDRESS=0x92e7b0d7029b1fe43f7da44ca9b0f805f3f31c25

WRITE_TOOLS_ENABLED=false
WALLET_MODE=managed-testnet
AUTO_CREATE_AGENT_WALLET=true
REQUIRE_AUTHORIZED_AGENT_FOR_WRITE=true
AUTO_AUTHORIZE_AGENT_WALLET=false

# ── DODO API (optional) ─────────────────────────────────────────────────
# Required for execute_swap, get_pool_info, simulate_transaction swap mode.
# Get a key from https://dodoex.github.io/docs/
# Leave blank if you only need preflight/risk tools.
DODO_API_KEY=

# ── Spend Limits ─────────────────────────────────────────────────────────
# Global fallback limits. Per-agent policy (`.agents/policies/`) takes
# precedence when configured via get_agent_policy / set_agent_policy.
MAX_TX_AMOUNT_PHRS=0.1
MAX_X402_PAYMENT_USDC=0.01
MAX_APPROVAL_AMOUNT_USDC=10
MAX_DAILY_SPEND_USD=10
PHRS_USD_PRICE=1.0

# ── Write Tool Gates ────────────────────────────────────────────────────
ALLOW_UNLIMITED_APPROVAL=false
ALLOW_LOCAL_X402_FETCH=false

# ── Observability (optional) ────────────────────────────────────────────
# AUDIT_LOG_PATH=./logs/safehands-audit.jsonl
# MCP_RATE_LIMIT_HEAVY=5
# MCP_RATE_LIMIT_WRITE=15
# MCP_RATE_LIMIT_DEFAULT=120

# ── x402 Server (only needed when running `npm run x402-server`) ────────
# X402_PAY_TO=
# X402_FACILITATOR_PRIVATE_KEY=
# X402_PRICE_USDC=0.001
X402_SERVER_PORT=4021

# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Advanced Local / Self-Hosted Execution (testnet only)              ║
# ║  Not default UX. Not for hosted backend user key collection.        ║
# ║  Still preflight/policy-gated. RiskRegistry authorization not       ║
# ║  required by default unless explicitly configured.                  ║
# ╚══════════════════════════════════════════════════════════════════════╝

# WALLET_MODE=env
# PRIVATE_KEY=0xTESTNET_PRIVATE_KEY_ONLY
# WRITE_TOOLS_ENABLED=true

# Managed wallet persistence (optional)
# WALLET_ENCRYPTION_KEY=
# WALLET_STORE_PATH=./.agents/wallets.json
# X402_SIGNER_PRIVATE_KEY=

# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Operator-Only Managed Wallet Authorization (testnet only)          ║
# ║  Never commit the owner key. Used for managed wallet                ║
# ║  onboarding/demo flows only.                                       ║
# ╚══════════════════════════════════════════════════════════════════════╝

# AUTO_AUTHORIZE_AGENT_WALLET=true
# RISK_REGISTRY_OWNER_PRIVATE_KEY=0xOWNER_TESTNET_PRIVATE_KEY_ONLY

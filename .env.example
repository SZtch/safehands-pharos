# ─────────────────────────────────────────────────────────────────────────────
# SafeHands-Pharos — environment template.   Copy to .env:  cp .env.example .env
#
# Read-only preflight works with NO .env at all. Everything below is optional and
# OFF by default. .env is gitignored — NEVER commit real secrets. This template
# holds placeholders only: never put a real private key here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Network (read-only defaults) ─────────────────────────────────────────────
PHAROS_ENVIRONMENT=pacific-mainnet
PHAROS_CHAIN_ID=1672
PHAROS_RPC_URL=https://rpc.pharos.xyz
# SAFEHANDS_NETWORK=pacific-mainnet          # pacific-mainnet | atlantic-testnet
# Optional premium RPC (read from env only; never hardcoded):
# PHAROS_MAINNET_RPC_URL=
# ZAN_PHAROS_MAINNET_RPC_URL=
# ALCHEMY_PHAROS_MAINNET_RPC_URL=
# PHAROS_RPC_PROVIDER=                       # zan | alchemy | nirvana | custom | pharos-public

# ── Live SafeHands contracts on Pharos Pacific (1672) ────────────────────────
SAFEHANDS_REGISTRY_ADDRESS=0x428e02bf85412e7242d991cd6725ec59e8b06c8d
SAFEHANDS_ATTESTATION_ADDRESS=0x71a7a87b3b1ab6d86204cad691bb32fd75b4588c

# ── Safety gates (ALL default false → read-only, zero-custody) ───────────────
# WRITE_TOOLS_ENABLED is the master switch — required before ANY write/payment
# tool can run. The two gates below it are ADDITIONAL and independently enforced:
#   SAFE_EXECUTE_ENABLED   → also required for the safehands_safe_execute
#                            preflight→execute path (read-only preflight_check needs neither).
#   MANAGED_WALLET_ENABLED → also required (with WALLET_MODE=managed-mainnet) before a
#                            stored managed wallet is ever used to sign.
WRITE_TOOLS_ENABLED=false
SAFE_EXECUTE_ENABLED=false
MANAGED_WALLET_ENABLED=false
PUBLISH_RISK_RECORDS_ENABLED=false
# ALLOW_UNLIMITED_APPROVAL=false
# ALLOW_LOCAL_X402_FETCH=false

# ── Self-hosted managed execution (opt-in; single-tenant, on a machine you control)
# WALLET_MODE=none                           # none | env | managed-mainnet
# PRIVATE_KEY=                               # env-wallet mode only — NEVER commit a real key
# DODO_API_KEY=                              # required for price / pool / swap routing
# PROS_USD_PRICE=1.0                         # STATIC fallback price used to convert PROS→USD for
#                                            # the daily spend caps (no oracle). If unset, 1.0 is
#                                            # assumed — set it CONSERVATIVELY (i.e. at or above the
#                                            # real market price) so caps never under-count spend.
# GOLDSKY_SUBGRAPH_URL=

# ── On-chain attestation (opt-in; attester key is separate from any user wallet)
# SAFEHANDS_ATTESTER_PRIVATE_KEY=            # NEVER commit a real key
# SAFEHANDS_ATTESTATION_REQUIRED=false
# SAFEHANDS_USER_SIGNED_BROADCAST_ENABLED=false
# SAFEHANDS_LOCAL_WALLET_HELPER_ENABLED=false

# ── x402 paid endpoints (opt-in) ─────────────────────────────────────────────
# RECOMMENDED (zero-custody, public production): the Guardian API /paid/* gate
# uses an EXTERNAL facilitator — no signing key ever touches this host. Paid
# routes are active only when BOTH are set; otherwise they fail closed (503).
# X402_PAY_TO=                               # receive-only address for earned fees
# X402_FACILITATOR_URL=                      # external x402 facilitator (verify/settle off-host)
# X402_PRICE_USDC=0.01
#
# DEV / self-hosted single-tenant ONLY: the standalone x402 server
# (`npm run start:x402`) signs settlements locally with this key (custody).
# With NODE_ENV=production it refuses to start unless
# SAFEHANDS_ALLOW_LOCAL_FACILITATOR=true is also set explicitly.
# X402_FACILITATOR_PRIVATE_KEY=              # NEVER commit a real key
# SAFEHANDS_ALLOW_LOCAL_FACILITATOR=false

# ── Production hosting (Guardian API) ────────────────────────────────────────
# NODE_ENV=production
# PORT=3000
# SAFEHANDS_STATE_DIR=/data                  # persistent volume path (durability)
# SAFEHANDS_CORS_ORIGIN=https://your.app     # tighten from * for guarded/paid surfaces
# SAFEHANDS_ALLOW_MANAGED_ON_PUBLIC=false    # required to run managed execution on a public host
# UPSTASH_REDIS_REST_URL=                    # x402 replay durability (optional)
# UPSTASH_REDIS_REST_TOKEN=

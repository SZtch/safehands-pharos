{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/sdk.ts",
    "src/cli.ts",
    "src/api/server.ts",
    "src/x402Server.ts",
    "src/worker.ts",
    "scripts/**/*.{ts,mjs}",
    "examples/**/*.ts",
    "test/**/*.{ts,mjs}"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"],
  "ignore": ["anvita/**", "contracts/**", "test/contracts/**"],
  "ignoreDependencies": [
    "hardhat",
    "@nomicfoundation/hardhat-toolbox",
    "@openzeppelin/contracts",
    "chai",
    "mocha",
    "@types/chai",
    "@types/mocha"
  ]
}

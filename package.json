{
  "name": "safehands-pharos",
  "version": "1.6.0",
  "description": "Pharos Skill Engine-compatible transaction safety firewall for AI agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "safehands-pharos": "dist/index.js"
  },
  "files": [
    "dist",
    "contracts",
    "README.md",
    "DEMO.md",
    ".env.example",
    "LICENSE",
    ".agents/skill/safehands/SKILL.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "x402-server": "tsx src/x402Server.ts",
    "demo": "tsx src/index.ts --demo",
    "test": "node scripts/smoke-test.mjs",
    "test:contracts": "npx hardhat test",
    "test:all": "npm run build && npm test && npm run demo && npm run test:contracts"
  },
  "keywords": [
    "pharos",
    "mcp",
    "mcp-skill",
    "defi",
    "risk-engine",
    "ai-agent",
    "farodex",
    "viem",
    "atlantic-testnet",
    "web3",
    "pharos-skill-engine",
    "guardrail",
    "transaction-safety",
    "transaction-firewall",
    "x402",
    "agent-safety",
    "safehands"
  ],
  "author": "SZtch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SZtch/safehands-pharos.git"
  },
  "homepage": "https://github.com/SZtch/safehands-pharos#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@x402/core": "^2.15.0",
    "@x402/evm": "^2.15.0",
    "@x402/express": "^2.15.0",
    "@x402/fetch": "^2.15.0",
    "express": "^5.2.1",
    "viem": "^2.31.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "hardhat": "^3.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
